# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=senegal_connect
DB_USER=postgres
DB_PASS=change_me

# JWT
# Générer un secret sûr avec : npm run secret
# Ne jamais committer la vraie valeur de production.
JWT_SECRET=CHANGE_ME_64_CHARACTERS_MINIMUM
JWT_EXPIRES_IN=24h

# Serveur
PORT=3000
LOG_LEVEL=debug
PEERJS_PORT=9001

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Upload
MAX_FILE_SIZE=10485760
