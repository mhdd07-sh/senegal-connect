# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=senegal_connect
DB_USER=postgres
DB_PASS=password

# JWT
# Générer un secret sûr avec : npm run secret   (ou : node scripts/generer-secret.js)
# NE JAMAIS committer le vrai secret — ce fichier .env.example ne contient qu'un exemple.
JWT_SECRET=4c5b393f50563a41be5662769cec983721cd56041f889ad153b9c01c9f4c1eb4
JWT_EXPIRES_IN=24h

# Serveur
PORT=3000
LOG_LEVEL=debug
PEERJS_PORT=9000
# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Upload
MAX_FILE_SIZE=10485760
